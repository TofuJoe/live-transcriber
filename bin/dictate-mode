#!/usr/bin/env bash
# Switch the dictation output mode.
#
# Writes a systemd drop-in rather than editing the unit itself, so the choice
# survives re-running install.sh -- same approach as dictate-backend, and a
# separate file from it so the two switches never clobber each other.
set -euo pipefail

DROPIN_DIR="$HOME/.config/systemd/user/dictation.service.d"
DROPIN="$DROPIN_DIR/mode.conf"

current() {
  local pid
  pid=$(systemctl --user show dictation.service -p MainPID --value 2>/dev/null || echo 0)
  if [[ "$pid" != "0" ]] && [[ -r "/proc/$pid/environ" ]]; then
    tr '\0' '\n' < "/proc/$pid/environ" | sed -n 's/^DICTATE_MODE=//p'
  else
    echo "(not running)"
  fi
}

usage() {
  cat <<EOF
usage: dictate-mode [phrase|stream|single|status]

  phrase   type each phrase as you pause. Lowest GPU load; least
           accurate, because each ~2s fragment is decoded with no context.
  stream   re-decode a growing window and type words once they stop
           changing. Best accuracy with live feedback; the GPU runs
           continuously while you speak.
  single   type everything at once when you stop. Best accuracy, no
           feedback until you finish.
  status   show which mode is live

currently: $(current)
EOF
}

case "${1:-status}" in
  status)
    echo "mode: $(current)"
    systemctl --user is-active --quiet dictation.service \
      && echo "service: active" || echo "service: NOT running"
    ;;
  phrase|stream|single)
    mkdir -p "$DROPIN_DIR"
    printf '[Service]\nEnvironment=DICTATE_MODE=%s\n' "$1" > "$DROPIN"
    systemctl --user daemon-reload
    systemctl --user restart dictation.service
    # Wait for THIS process to report ready. Matching on time alone races
    # against the previous start's log lines, which look identical.
    pid=$(systemctl --user show dictation.service -p MainPID --value)
    for _ in $(seq 1 30); do
      ready=$(journalctl --user -u dictation.service --no-pager 2>/dev/null \
              | grep "python\[$pid\]: Ready:" | tail -1 || true)
      if [[ -n "$ready" ]]; then
        echo "mode: $(current)"
        echo "$ready" | sed 's/.*python\[[0-9]*\]: /  /'
        exit 0
      fi
      systemctl --user is-active --quiet dictation.service || {
        echo "daemon died; see: journalctl --user -u dictation -e" >&2; exit 1; }
      sleep 1
    done
    echo "timed out waiting for daemon; see: journalctl --user -u dictation -e" >&2
    exit 1
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
